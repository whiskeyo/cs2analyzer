# Stamped at build time (__HTACCESS_REV__ → git short SHA). Proves Apache read this file.
Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html

AddType application/wasm .wasm
<FilesMatch "\.wasm$">
  ForceType application/wasm
</FilesMatch>

<IfModule mod_headers.c>
  # `always` so the rev is present on 404 and 403, not only on 200.
  Header always set X-Htaccess-Rev "__HTACCESS_REV__"
  <FilesMatch "\.wasm$">
    Header set Content-Type "application/wasm"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

# Local URL keeps the status (a full URL would 302 and turn the 404 into a redirect).
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # /route and /route/ → that directory's index.html. DirectorySlash Off is what
  # stops OVH's 301 to https://host:443/route/ ; this rewrite still serves the file.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>
